# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/

# built APK artifacts (large binaries — never commit; install from disk)
*.apk

# Supabase CLI scratch state (project ref + org id, machine-local)
supabase/.temp/

# Ad-hoc screenshots dropped at the repo root while debugging
/repro.png

# Local quarantine for regenerable build output pending deletion
_trash/

# Release signing material. android/.gitignore covers these too, but only for
# paths under android/ — a keystore kept anywhere else in the tree was one
# `git add -A` away from being committed, and a signing key in git history is a
# signing key that has to be replaced.
*.jks
*.keystore
key.properties
