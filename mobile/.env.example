# Copy to mobile/.env and fill in. Never committed.
#
# The NEXT_PUBLIC_ prefix is a leftover from a Next.js prototype that no longer
# exists. It is kept because it is what lib/core/config.dart reads and what the
# working .env files on the build machines already use — renaming it would fail
# startup on every machine that did not migrate in the same commit, and the
# failure is a hard StateError before the first frame.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the project's anon/publishable key>
