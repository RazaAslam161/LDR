# Copy to android/maps.properties and fill in. NEVER commit the real file —
# android/.gitignore already excludes maps.properties.
#
# This is the Android key for the Google Maps SDK (Touch Map). It ends up in
# the merged manifest and therefore in the artifact, so it is only ever as safe
# as its restrictions: pin it to the package name com.miles.miles AND the
# release signing certificate's SHA-1, and enable only "Maps SDK for Android"
# on it in the Google Cloud console.
#
mapsApiKey=
