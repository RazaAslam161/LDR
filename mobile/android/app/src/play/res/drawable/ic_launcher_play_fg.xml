<?xml version="1.0" encoding="utf-8"?>
<!-- Two lights and the line between them: the whole app in one mark.

     Drawn in Android's 108-unit adaptive grid. The two cores sit inside the
     66-unit safe square so no launcher mask can clip them; the glows are
     allowed to run past it, because a soft falloff losing its last few percent
     at the mask edge is invisible, and keeping them inside would have shrunk
     the cores to dots.

     The lower-left light is the larger one. Two lights of equal size read as a
     symbol; unequal ones read as two people, one nearer than the other. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Bloom under the near light. Painted before the thread so the line
         emerges from the glow rather than sitting on top of it. -->
    <path android:pathData="M18,70 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40" android:centerY="70"
                android:gradientRadius="22">
                <item android:offset="0.0" android:color="#B8FF8A5E" />
                <item android:offset="0.35" android:color="#5CE8674A" />
                <item android:offset="1.0" android:color="#00E8674A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bloom under the far light: smaller radius and a lower peak, so the
         distance reads as distance rather than as two different marks. -->
    <path android:pathData="M57,38 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="73" android:centerY="38"
                android:gradientRadius="16">
                <item android:offset="0.0" android:color="#A6FF8A5E" />
                <item android:offset="0.35" android:color="#4DE8674A" />
                <item android:offset="1.0" android:color="#00E8674A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The thread. Stroked rather than filled so it keeps an even weight, and
         round-capped so it disappears into each core instead of ending in a
         visible flat edge. Brightest at the near end, which is what makes the
         curve read as travelling away. -->
    <path
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M40,70 C44,54 56,42 73,38">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="70"
                android:endX="73" android:endY="38">
                <item android:offset="0.0" android:color="#FFFFA981" />
                <item android:offset="1.0" android:color="#CCE8674A" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillColor="#FFFFF1E8"
        android:pathData="M34.6,70 a5.4,5.4 0 1,0 10.8,0 a5.4,5.4 0 1,0 -10.8,0 Z" />

    <path
        android:fillColor="#FFFFE4D2"
        android:pathData="M69.4,38 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0 Z" />
</vector>
