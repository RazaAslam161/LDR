<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for Supabase API + Realtime -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback for the Reach feature -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Biometric prompt for Memory Threads PIN gate -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Coarse location for the Time Capsule "when you're together" proximity unlock -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- No ACCESS_BACKGROUND_LOCATION / FOREGROUND_SERVICE_LOCATION. They were
         declared for an always-on location-sharing feature that was never built:
         location_service.dart says in its own doc comment that sharing is
         foreground-only, and the one startService call
         (call_foreground.dart) requests the microphone type alone. Background
         location is the most alarming line Android shows in an app's permission
         list, which is a poor thing for an app whose whole design goal is being
         unremarkable. Re-add them WITH the service type below if the feature is
         ever actually written. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keep a voice/video call alive when the app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- A video call runs the camera from a foreground service. Without the
         matching type Android 14+ refuses to start it, and the call dies. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Microphone for Time Capsule voice memos + chat voice notes + video calls -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebRTC video calling: audio routing + network state -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Needed on Android 12+ to see a bluetooth headset at all, which is what
         call audio routing picks between. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Camera for photo + video capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Gallery access for sharing photos + videos (private app, not Play-bound) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Save-to-gallery on legacy Android (API ≤28); 29+ uses MediaStore (gal) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Reach: full-screen wake alert (foreground now; FCM background later) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="News"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBa6XGzV-g28HSX9rp3AeVs2YPzSlDTyH4" />
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- importantForAutofill: belt-and-braces. Flutter only registers a
             field with the Autofill framework when autofillHints is set, and
             this app sets it nowhere, so today this changes nothing; it keeps
             Autofill out if a field ever does opt in. The suggestion popup the
             user actually saw is the IME's, suppressed on the fields
             themselves (enableSuggestions / enableIMEPersonalizedLearning). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:importantForAutofill="noExcludeDescendants"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <!-- MAIN/LAUNCHER deliberately lives on the aliases below, not here.
                 An activity plus its aliases would each show their own launcher
                 entry, which is the opposite of a disguise. -->

            <!-- Pairing deep link: tethered://join?code=ABCDEF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tethered" android:host="join" />
            </intent-filter>

            <!-- Auth callback: tethered://auth-callback
                 Email confirmation and password-reset links land here. Without
                 it Supabase falls back to its default Site URL, so every
                 confirmation and reset mail opened "localhost refused to
                 connect" — on a phone, which has no server on :3000. That is
                 every new signup and every forgotten password. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tethered" android:host="auth-callback" />
            </intent-filter>

            <!-- Share target: a link shared from Instagram, TikTok, YouTube or
                 a browser lands in the couple's queue.

                 Deliberately NO android:label. The share sheet shows the
                 activity's label, and this app wears a disguise — a chooser
                 entry reading "Miles" beside the others would announce the
                 product to anyone glancing at the phone while its launcher icon
                 says something else entirely. Inheriting means it appears as
                 whatever cover is active. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ── Launcher disguises ────────────────────────────────────────────
             One alias per identity the user can choose; MainActivity.kt enables
             exactly one at a time over the `miles/disguise` channel. The label
             and icon a launcher shows come from HERE, not from Dart, so
             lib/features/disguise/disguise_profile.dart must be kept in step.

             EXACTLY ONE may ship with android:enabled="true". News is it, so an
             upgrade keeps the identity the app was installed with. -->
        <activity-alias
            android:name=".AliasNews"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="News"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Calculator"
            android:icon="@mipmap/ic_disguise_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Notes"
            android:icon="@mipmap/ic_disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasWeather"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Weather"
            android:icon="@mipmap/ic_disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasConvert"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Convert"
            android:icon="@mipmap/ic_disguise_convert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasRecorder"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Recorder"
            android:icon="@mipmap/ic_disguise_recorder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasTimer"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Timer"
            android:icon="@mipmap/ic_disguise_timer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasLevel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Level"
            android:icon="@mipmap/ic_disguise_level">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasDevice"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Device Info"
            android:icon="@mipmap/ic_disguise_device">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Force the Skia renderer. Impeller (Vulkan) on Android segfaults in
             libflutter.so when compositing the live camera-preview texture under
             BackdropFilter/blend-mode filter stack (rapid_camera_screen). Skia
             handles it; the tiny first-frame shader jank is an acceptable trade. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />


        <!-- Default FCM channel (used if a notification-type message ever arrives;
             our Reach pushes are data-only and routed to reach_channel in code). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reach_channel" />

        <!-- Small icons for the call foreground service, one per disguise.
             flutter_foreground_task resolves its icon through a manifest
             meta-data name rather than a resource string, so every cover needs
             an entry here; DisguiseNotificationStyle.iconMetaData derives the
             name from the drawable, so these must stay named after them.
             Without an entry the plugin falls back to @mipmap/ic_launcher,
             which masks down to a solid white square in the status bar. -->
        <meta-data android:name="ic_notif_news" android:resource="@drawable/ic_notif_news" />
        <meta-data android:name="ic_notif_calculator" android:resource="@drawable/ic_notif_calculator" />
        <meta-data android:name="ic_notif_notes" android:resource="@drawable/ic_notif_notes" />
        <meta-data android:name="ic_notif_weather" android:resource="@drawable/ic_notif_weather" />
        <meta-data android:name="ic_notif_convert" android:resource="@drawable/ic_notif_convert" />
        <meta-data android:name="ic_notif_recorder" android:resource="@drawable/ic_notif_recorder" />
        <meta-data android:name="ic_notif_timer" android:resource="@drawable/ic_notif_timer" />
        <meta-data android:name="ic_notif_level" android:resource="@drawable/ic_notif_level" />
        <meta-data android:name="ic_notif_device" android:resource="@drawable/ic_notif_device" />

        <!-- image_cropper (uCrop) photo crop/adjust activity -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- flutter_foreground_task: keeps a call running in the background,
             and runs the persistent live-location foreground service.
             Combined service types: microphone (calls) + location (live sharing).
             Warning: do not change the service name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|camera"
            android:exported="false"
            android:stopWithTask="true" />
    </application>

    <!-- Supabase Auth deep-link for email confirmation + OAuth redirects -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Watch Together hands links it cannot embed to a browser. Without
             http declared here, Android 11+ package visibility hides every
             http:// handler and the hand-off silently does nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
