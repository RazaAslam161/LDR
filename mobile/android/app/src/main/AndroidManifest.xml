<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Supabase API + Realtime -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptic feedback for the Reach feature -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Biometric prompt for Memory Threads PIN gate -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Coarse location for the Time Capsule "when you're together" proximity unlock -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- No ACCESS_BACKGROUND_LOCATION / FOREGROUND_SERVICE_LOCATION. They were
         declared for an always-on location-sharing feature that was never built:
         location_service.dart says in its own doc comment that sharing is
         foreground-only, and the one startService call
         (call_foreground.dart) requests the microphone type alone. Background
         location is the most alarming line Android shows in an app's permission
         list, which is a poor thing for an app whose whole design goal is being
         unremarkable. Re-add them WITH the service type below if the feature is
         ever actually written. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keep a voice/video call alive when the app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- No FOREGROUND_SERVICE_CAMERA / camera service type. The one
         startService call site (call_foreground.dart) builds its type set from
         callServiceTypes(), which returns microphone, plus mediaProjection
         while a screen share is live — never camera. A declared-but-unrequested
         FGS type still costs a Play Console declaration and a demo video for a
         capability the app does not have. Backgrounded video capture is
         already blocked today for the same reason the type is unused; adding it
         means re-adding BOTH this permission and the type on the service. -->
    <!-- Screen share streams the whole display into a call, and Android 14+
         refuses to start a mediaProjection-typed service without this. Kept
         beside the call permissions it serves rather than added speculatively:
         it reads alarmingly in a permission list for a news reader. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Microphone for Time Capsule voice memos + chat voice notes + video calls -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebRTC video calling: audio routing + network state -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Needed on Android 12+ to see a bluetooth headset at all, which is what
         call audio routing picks between. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Camera for photo + video capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- No READ_MEDIA_IMAGES / READ_MEDIA_VIDEO. Every gallery entry point is
         image_picker, and neither of its two paths needs them: PickVisualMedia
         (the system photo picker, which PhotoPickerService switches on) and
         ACTION_GET_CONTENT (the default, still used by capsule_fill,
         propose_memory and touch_map) both hand back a URI carrying its own
         read grant. Nothing in lib/ scans the gallery, so broad media access
         has no justification to give Play's Photo and Video Permissions
         declaration. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Reach: full-screen wake alert (foreground now; FCM background later) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hardware opt-outs. Play derives an IMPLICIT required="true" uses-feature
         from several of the permissions above and filters the Store listing on
         it: CAMERA implies camera + camera.autofocus, RECORD_AUDIO implies
         microphone, ACCESS_FINE/COARSE_LOCATION imply location(.gps/.network),
         BLUETOOTH implies bluetooth, and Play services' own USE_FINGERPRINT
         (merged in transitively) implies fingerprint. touchscreen is assumed
         required for every app unless it is opted out.

         None of it is actually required: this app's centre is chat, calls and
         shared memories. A tablet with no rear camera, a Chromebook, a handset
         with no fingerprint reader or no GPS all run it — they simply do not
         see the one feature they lack. Left implicit, each line silently
         subtracts devices from a Store listing with no error anywhere.

         camera.any carries tools:replace because camera_android_camerax
         declares it with no required attribute (verified in
         build/app/intermediates/merged_manifest/playRelease/), which the merger
         reads as required="true" and ORs over ours.

         NOT opted out: Mapbox's glEsVersion 0x00030000 required="true"
         (com.mapbox.maps:android-core-ndk27:11.28.1). Mapbox genuinely needs
         GLES 3.0, essentially every minSdk-24 device has it, so the filter
         costs no real devices and relaxing it would trade a clean "not
         compatible" for a broken map. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false"
        tools:replace="android:required" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- android:label and android:icon are NOT here. They are the one thing the
         two channels must disagree about, so each flavour's manifest supplies
         its own — src/sideload (the disguise) and src/play (the honest name and
         icon). Adding either attribute back here would need a tools:replace on
         both sides to override it. -->
    <application
        android:name="${applicationName}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />


        <!-- importantForAutofill: belt-and-braces. Flutter only registers a
             field with the Autofill framework when autofillHints is set, and
             this app sets it nowhere, so today this changes nothing; it keeps
             Autofill out if a field ever does opt in. The suggestion popup the
             user actually saw is the IME's, suppressed on the fields
             themselves (enableSuggestions / enableIMEPersonalizedLearning). -->
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:importantForAutofill="noExcludeDescendants"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <!-- No MAIN/LAUNCHER here. The sideload channel puts it on its
                 activity-aliases (an activity plus its aliases would each show
                 their own launcher entry, which is the opposite of a disguise);
                 the play channel, which has no aliases, puts it back on this
                 activity. Declaring it here would give the sideload build two
                 entries. -->

            <!-- Pairing deep link: tethered://join?code=ABCDEF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tethered" android:host="join" />
            </intent-filter>

            <!-- Auth callback: tethered://auth-callback
                 Email confirmation and password-reset links land here. Without
                 it Supabase falls back to its default Site URL, so every
                 confirmation and reset mail opened "localhost refused to
                 connect" — on a phone, which has no server on :3000. That is
                 every new signup and every forgotten password. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tethered" android:host="auth-callback" />
            </intent-filter>

            <!-- Share target: a link shared from Instagram, TikTok, YouTube or
                 a browser lands in the couple's queue.

                 Deliberately NO android:label. The share sheet shows the
                 activity's label, and this app wears a disguise — a chooser
                 entry reading "Miles" beside the others would announce the
                 product to anyone glancing at the phone while its launcher icon
                 says something else entirely. Inheriting means it appears as
                 whatever cover is active. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Force the Skia renderer. Impeller (Vulkan) on Android segfaults in
             libflutter.so when compositing the live camera-preview texture under
             BackdropFilter/blend-mode filter stack (rapid_camera_screen). Skia
             handles it; the tiny first-frame shader jank is an acceptable trade. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />


        <!-- Default FCM channel (used if a notification-type message ever arrives;
             our Reach pushes are data-only and routed to reach_channel in code). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reach_channel" />

        <!-- Small icons for the call foreground service, one per disguise.
             flutter_foreground_task resolves its icon through a manifest
             meta-data name rather than a resource string, so every cover needs
             an entry here; DisguiseNotificationStyle.iconMetaData derives the
             name from the drawable, so these must stay named after them.
             Without an entry the plugin falls back to @mipmap/ic_launcher,
             which masks down to a solid white square in the status bar. -->
        <meta-data android:name="ic_notif_news" android:resource="@drawable/ic_notif_news" />
        <meta-data android:name="ic_notif_calculator" android:resource="@drawable/ic_notif_calculator" />
        <meta-data android:name="ic_notif_notes" android:resource="@drawable/ic_notif_notes" />
        <meta-data android:name="ic_notif_weather" android:resource="@drawable/ic_notif_weather" />
        <meta-data android:name="ic_notif_convert" android:resource="@drawable/ic_notif_convert" />
        <meta-data android:name="ic_notif_recorder" android:resource="@drawable/ic_notif_recorder" />
        <meta-data android:name="ic_notif_timer" android:resource="@drawable/ic_notif_timer" />
        <meta-data android:name="ic_notif_level" android:resource="@drawable/ic_notif_level" />
        <meta-data android:name="ic_notif_device" android:resource="@drawable/ic_notif_device" />

        <!-- image_cropper (uCrop) photo crop/adjust activity -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- flutter_foreground_task: keeps a call running in the background.
             Calls are its only user — location sharing is foreground-only and
             starts no service, whatever this comment used to claim. The types
             here are a ceiling the runtime set must fit inside, not a
             description of it: the service starts as microphone, plus
             mediaProjection for the duration of a screen share. `camera` was
             listed here and never requested — see the permission block above.
             Warning: do not change the service name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|mediaProjection"
            android:exported="false"
            android:stopWithTask="true" />
    </application>

    <!-- Supabase Auth deep-link for email confirmation + OAuth redirects -->
    <queries>
        <!-- BROWSABLE is not optional, and leaving it out is why every one of
             these silently did nothing on Android 11+. Package visibility
             matches this declaration against a target's intent-filters, and a
             browser's https filter carries BROWSABLE — so a query without it
             matches no browser at all, launchUrl finds no handler, returns
             false, and the user taps a link that does nothing. It cost the
             privacy-policy link in Settings and the Watch Together hand-off,
             both of which read as dead buttons rather than as a manifest
             problem. See url_launcher's README, which specifies exactly this
             three-element shape. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
</manifest>
