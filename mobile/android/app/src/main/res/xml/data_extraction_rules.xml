<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device through backup or transfer.

  allowBackup="false" alone does not cover Android 12+: cloud-backup and
  device-to-device transfer are governed here instead. The app's private
  storage holds the Supabase refresh token (a bearer credential for the whole
  account) and the app-lock PIN, so an extractable backup is an extractable
  session.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
