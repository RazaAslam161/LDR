<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LIGHT ON PURPOSE, in the -night folder, and that is not a mistake.

         The window themes here have to match the FIRST FLUTTER FRAME, not the
         app's own palette. On a shipped build DISGUISE_ENABLED is true
         (build.gradle.kts:83,157), so MilesApp.showRealApp starts false and the
         first frame is the "News" cover — coverHostTheme() is
         Brightness.light on a white scaffold
         (disguise_cover_host.dart:50-55), which main.dart:890 describes as
         sharing nothing with the dark theme underneath.

         So a phone with the OS in dark mode used to open black (this file's old
         Theme.Black) and then flash to a white cover. Matching values/styles.xml
         removes that: white splash, white first frame, in both OS modes. The
         real app's dark theme arrives later, behind a deliberate in-app
         transition, not a splash swap.

         Coupled to the cover: if the cover ever stops being the first frame,
         this file goes back to Theme.Black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
