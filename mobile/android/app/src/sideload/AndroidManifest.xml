<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The directly-shared build. Everything in here is the launcher disguise,
         and it exists in this source set precisely so that none of it reaches
         Google Play: an app that presents itself as a Calculator is Deceptive
         Behavior under Play policy, which is an account strike rather than a
         rejection. See src/play/AndroidManifest.xml for the honest one. -->

    <application
        android:label="Miles"
        android:icon="@mipmap/ic_launcher_play">

        <!-- ── Launcher identities ───────────────────────────────────────────
             One alias per identity the user can choose; MainActivity.kt enables
             exactly one at a time over the `miles/disguise` channel. The label
             and icon a launcher shows come from HERE, not from Dart, so
             lib/features/disguise/disguise_profile.dart must be kept in step.

             EXACTLY ONE may ship with android:enabled="true". Miles is it: the
             app installs as itself and offers the covers on first open, so the
             identity on the launcher is always one the owner picked. An upgrade
             keeps whichever identity the app is currently wearing, because the
             enabled state lives on the device, not in this file. -->
        <activity-alias
            android:name=".AliasMiles"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="Miles"
            android:icon="@mipmap/ic_launcher_play">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The only share target, for the reason given on the play
                 manifest's copy of this block: the share sheet names the
                 APPLICATION, so under a cover the app must be absent from it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasNews"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="News"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Calculator"
            android:icon="@mipmap/ic_disguise_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Notes"
            android:icon="@mipmap/ic_disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasWeather"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Weather"
            android:icon="@mipmap/ic_disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasConvert"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Convert"
            android:icon="@mipmap/ic_disguise_convert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasRecorder"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Recorder"
            android:icon="@mipmap/ic_disguise_recorder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasTimer"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Timer"
            android:icon="@mipmap/ic_disguise_timer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasLevel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Level"
            android:icon="@mipmap/ic_disguise_level">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasDevice"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Device Info"
            android:icon="@mipmap/ic_disguise_device">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
