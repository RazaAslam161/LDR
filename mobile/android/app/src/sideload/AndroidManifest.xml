<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The directly-shared build. Everything in here is the launcher disguise,
         and it exists in this source set precisely so that none of it reaches
         Google Play: an app that presents itself as a Calculator is Deceptive
         Behavior under Play policy, which is an account strike rather than a
         rejection. See src/play/AndroidManifest.xml for the honest one. -->

    <!-- In-app self-update. There is no store for this channel, so the app
         installs its own updates (UpdateService + the miles/updater channel).
         Deliberately declared HERE and not in main: an app that downloads and
         installs its own APK is a Device and Network Abuse strike on Play, so
         the play channel must never carry this permission or the FileProvider. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="News"
        android:icon="@mipmap/ic_launcher">

        <!-- Hands the downloaded APK to the system installer as a content:// URI.
             Authority matches MainActivity's install(): "$packageName.fileprovider".
             Paths in src/sideload/res/xml/provider_paths.xml expose only the cache
             dir getTemporaryDirectory() writes to. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- ── Launcher disguises ────────────────────────────────────────────
             One alias per identity the user can choose; MainActivity.kt enables
             exactly one at a time over the `miles/disguise` channel. The label
             and icon a launcher shows come from HERE, not from Dart, so
             lib/features/disguise/disguise_profile.dart must be kept in step.

             EXACTLY ONE may ship with android:enabled="true". News is it, so an
             upgrade keeps the identity the app was installed with. -->
        <activity-alias
            android:name=".AliasNews"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="News"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Calculator"
            android:icon="@mipmap/ic_disguise_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Notes"
            android:icon="@mipmap/ic_disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasWeather"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Weather"
            android:icon="@mipmap/ic_disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasConvert"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Convert"
            android:icon="@mipmap/ic_disguise_convert">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasRecorder"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Recorder"
            android:icon="@mipmap/ic_disguise_recorder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasTimer"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Timer"
            android:icon="@mipmap/ic_disguise_timer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasLevel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Level"
            android:icon="@mipmap/ic_disguise_level">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".AliasDevice"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="Device Info"
            android:icon="@mipmap/ic_disguise_device">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
